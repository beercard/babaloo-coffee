# ---------- Payload CMS (apps/cms) ----------
# Long random string (openssl rand -hex 32). Required.
PAYLOAD_SECRET=change-me

# SQLite file (default) or a Turso database (libsql://<name>-<org>.turso.io + DATABASE_AUTH_TOKEN) for Vercel.
DATABASE_URL=file:./babaloo.db
DATABASE_AUTH_TOKEN=
# Schema sync: automatic in dev; set DB_PUSH=1 to force it (e.g. first seed against Turso).
DB_PUSH=

# Vercel Blob storage for uploads (leave empty to store files in apps/cms/media).
BLOB_READ_WRITE_TOKEN=

# Public URL of this CMS (used for absolute media URLs, cookies)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Website origin(s) allowed to call the forms endpoint (comma separated)
SITE_URL=http://localhost:4321,https://babaloocoffeeclub.com

# ---------- Rebuild the static site when content changes ----------
# GitHub repository_dispatch (see docs/DEPLOY.md):
# DEPLOY_HOOK_URL=https://api.github.com/repos/<owner>/<repo>/dispatches
# DEPLOY_HOOK_TOKEN=github_pat_xxx
# DEPLOY_HOOK_BODY={"event_type":"cms-publish"}
# Or a Vercel / Netlify / Cloudflare build hook URL with no token.
DEPLOY_HOOK_URL=
DEPLOY_HOOK_TOKEN=
DEPLOY_HOOK_BODY=
DEPLOY_DEBOUNCE_MS=60000

# ---------- Admin protection ----------
# Payload locks an account for 15 min after 5 failed logins (collections/Users.ts).
# Optional: only these IPs may open /admin (comma separated). Leave empty to allow all.
ADMIN_ALLOWED_IPS=

# ---------- Form notifications ----------
# Inbox that receives every contact / job form
FORM_NOTIFY_EMAIL=info@babaloocoffeeclub.com
# SMTP used to send them (Hostinger mailbox: smtp.hostinger.com, 465, the mailbox login)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=info@babaloocoffeeclub.com
EMAIL_FROM_NAME=Babaloo Coffee Club
# Webhook for CRM / Zapier / n8n / WhatsApp automations
FORM_WEBHOOK_URL=
FORM_RATE_LIMIT=5

# ---------- Seed (first run only) ----------
SEED_ADMIN_EMAIL=admin@babaloocoffeeclub.com
SEED_ADMIN_PASSWORD=ChangeMe-123!
# Client editor account (created, or its password updated, on every seed run)
SEED_EDITOR_EMAIL=
SEED_EDITOR_PASSWORD=
SEED_EDITOR_NAME=Babaloo
