# ---------- Frontend (apps/web) ----------
# Canonical URL of the production site (used for sitemap, canonical tags, JSON-LD)
SITE_URL=https://babaloocoffeeclub.com

# Payload CMS base URL. Leave EMPTY to build from the local seed (src/content/seed).
PAYLOAD_URL=
# Optional Payload API key (only needed if the REST API is made private)
PAYLOAD_API_KEY=

# Public CMS URL used by the browser for form submissions (usually same as PAYLOAD_URL)
PUBLIC_CMS_URL=
# Or point the forms somewhere else entirely (Formspree, n8n, Zapier…)
PUBLIC_FORM_ENDPOINT=
# Without a CMS or endpoint, forms are emailed to the site contact via FormSubmit; set to off to disable
PUBLIC_FORM_RELAY=

# ---------- Analytics (all optional; nothing loads when empty) ----------
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
PUBLIC_GADS_ID=
PUBLIC_META_PIXEL_ID=
