---
/**
 * The interactive menu from PDF page 2.
 *
 *  Left  — photo panel whose picture changes when a product is clicked
 *          ("fotos cambian"); background alternates concrete / sage per
 *          category, as in the artboard.
 *  Right — accordion: CATEGORY (+) → Hot / Iced (+ / -) → items with
 *          description and price. Built on <details>, so it works without JS;
 *          the script only swaps the photo and remembers the open category.
 *
 * All names, descriptions, prices and photos come from the CMS.
 */
import type { MenuData } from '@/lib/cms/types';
import { buildMenuTree, type MenuTree } from '@/lib/cms';
import { itemPrice } from '@/utils/format';
import { getImage } from 'astro:assets';
import Picture from '@/components/ui/Picture.astro';
import concrete from '@/assets/textures/concrete.jpg';

interface Props {
  menu: MenuData;
  showPrices?: boolean;
}
const { menu, showPrices = true } = Astro.props;
const tree = buildMenuTree(menu.categories, menu.items);
const texture = await getImage({ src: concrete, width: 480, format: 'webp', quality: 55 });

/** Every image that can appear in the panel, keyed by id (items + categories). */
const visuals = new Map<string, { image: NonNullable<MenuData['items'][number]['image']>; label: string }>();
const collect = (nodes: MenuTree[]) => {
  for (const node of nodes) {
    if (node.category.image) visuals.set(node.category.id, { image: node.category.image, label: node.category.name });
    for (const item of node.items) if (item.image) visuals.set(item.id, { image: item.image, label: item.name });
    collect(node.children);
  }
};
collect(tree);

/** First image to show: the first top-level category image, else the first item image. */
const firstVisual = tree[0]?.category.image ? tree[0].category.id : [...visuals.keys()][0];

/** Sub-section kind (hot drives the steam on the photo panel): hot · iced · salty · sweet · other. */
type SubKind = 'hot' | 'iced' | 'salty' | 'sweet' | 'other';
function subKind(slug: string): SubKind {
  if (/hot/.test(slug)) return 'hot';
  if (/ice|cold/.test(slug)) return 'iced';
  if (/salt|savory|savoury|bite/.test(slug)) return 'salty';
  if (/sweet|dessert/.test(slug)) return 'sweet';
  return 'other';
}

/** Slug for a label, used to colour location badges (rea-farms · south-end · lake-norman). */
const tagSlug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-');

/** Which id should the panel show for a given item (its own image or its category's). */
function visualFor(itemId: string, image: unknown, categoryId: string, topId: string): string | undefined {
  if (image) return itemId;
  if (visuals.has(categoryId)) return categoryId;
  if (visuals.has(topId)) return topId;
  return undefined;
}
---

<div class="board" data-board>
  <div class="board__visual" data-board-visual data-tone="0" aria-live="polite">
    <div class="board__visual-inner">
      <div class="steam board__steam" aria-hidden="true"><span></span><span></span><span></span></div>
      {
        [...visuals.entries()].map(([id, v], i) => (
          <figure class:list={['board__figure', id === firstVisual && 'is-active']} data-board-image={id} hidden={id === firstVisual ? undefined : true}>
            <Picture image={v.image} alt={v.image.alt || v.label} sizes="(min-width: 900px) 38vw, 80vw" widths={[360, 560, 800, 1000]} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} class="board__img" />
            <figcaption class="visually-hidden">{v.label}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>

  <div class="board__list">
    {
      tree.map((top, ti) => (
        <details class="board__cat" data-board-cat data-tone={ti % 2} data-visual={visuals.has(top.category.id) ? top.category.id : undefined} id={top.category.slug}>
          <summary class="board__row board__row--cat">
            <h2 class="board__cat-name">{top.category.name}</h2>
            <span class="board__toggle" aria-hidden="true" />
          </summary>
          <div class="board__panel" data-board-panel>
          {top.category.description && <p class="board__cat-desc">{top.category.description}</p>}

          {top.items.length > 0 && (
            <ul role="list" class="board__items">
              {top.items.map((item) => {
                const price = showPrices ? itemPrice(item, menu.currency) : undefined;
                const visual = visualFor(item.id, item.image, top.category.id, top.category.id);
                return (
                  <li class="board__item" id={item.slug}>
                    <button type="button" class="board__item-btn" data-board-item data-visual={visual} aria-pressed="false">
                      <span class="board__item-name">
                        {item.name}
                        {item.tags.map((t) => (
                          <span class="board__tag" data-tag={tagSlug(t)}>{t}</span>
                        ))}
                      </span>
                      {price && <span class="board__price">{price}</span>}
                    </button>
                    {item.description && <p class="board__desc">{item.description}</p>}
                    {item.variants.length > 1 && showPrices && (
                      <ul role="list" class="board__variants">
                        {item.variants.map((v) => (
                          <li>
                            <span>{v.name}</span> <span class="board__price">{itemPrice({ ...item, price: v.price, priceLabel: undefined, variants: [] }, menu.currency)}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                );
              })}
            </ul>
          )}

          {top.children.map((sub, si) => (
            <details class="board__sub" data-board-sub data-kind={subKind(sub.category.slug)} data-visual={visuals.has(sub.category.id) ? sub.category.id : undefined} id={`${top.category.slug}-${sub.category.slug}`}>
              <summary class:list={['board__row', 'board__row--sub', `board__row--${subKind(sub.category.slug)}`]}>
                <h3 class="board__sub-name">
                  <span class="board__sub-label">{sub.category.name}</span>
                </h3>
                <span class="board__toggle" aria-hidden="true" />
              </summary>
              <div class="board__panel" data-board-panel>
              <ul role="list" class="board__items">
                {sub.items.map((item) => {
                  const price = showPrices ? itemPrice(item, menu.currency) : undefined;
                  const visual = visualFor(item.id, item.image, sub.category.id, top.category.id);
                  return (
                    <li class="board__item" id={item.slug}>
                      <button type="button" class="board__item-btn" data-board-item data-visual={visual} aria-pressed="false">
                        <span class="board__item-name">
                          {item.name}
                          {item.tags.map((t) => (
                            <span class="board__tag" data-tag={tagSlug(t)}>{t}</span>
                          ))}
                        </span>
                        {price && <span class="board__price">{price}</span>}
                      </button>
                      {item.description && <p class="board__desc">{item.description}</p>}
                      {item.variants.length > 1 && showPrices && (
                        <ul role="list" class="board__variants">
                          {item.variants.map((v) => (
                            <li>
                              <span>{v.name}</span> <span class="board__price">{itemPrice({ ...item, price: v.price, priceLabel: undefined, variants: [] }, menu.currency)}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  );
                })}
              </ul>
              </div>
            </details>
          ))}
          </div>
        </details>
      ))
    }
  </div>
</div>

<script>
  import { initMenuBoard } from '@/scripts/menu-board';
  document.addEventListener('astro:page-load', initMenuBoard);
</script>

<style define:vars={{ texture: `url(${texture.src})` }}>
  .board {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--cream);
    --panel-h: min(36vh, 22rem);
  }
  @media (min-width: 900px) {
    .board {
      /* PDF: photo column 0–800, list 800–1920 */
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
  }

  /* ---------- photo panel ---------- */
  .board__visual {
    position: sticky;
    top: var(--header-h);
    z-index: 2;
    background-color: var(--concrete-light);
    background-image: var(--texture);
    background-size: 480px auto;
    transition: background-color 600ms ease;
    /* Panel height (set on .board) so the photo and the list can be sized against it reliably. */
    height: var(--panel-h);
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .board {
      --panel-h: min(calc(100vh - var(--header-h)), 60rem);
    }
  }
  .board__visual-inner {
    position: relative;
    height: 100%;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 4rem);
  }
  .board__figure {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: inherit;
    opacity: 0;
    transition: opacity 500ms ease;
  }
  .board__figure.is-active {
    opacity: 1;
  }
  .board__steam {
    top: 14%;
    opacity: 0;
    transition: opacity 600ms;
  }
  .board__visual[data-hot='true'] .board__steam {
    opacity: 1;
  }
  .board__figure[hidden] {
    display: none;
  }
  .board__figure :global(picture) {
    display: contents;
  }
  :global(.board__img) {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    /* PDF: the product cup ≈ 60% of the panel height */
    max-height: calc(var(--panel-h) * 0.72);
    object-fit: contain;
    filter: drop-shadow(0 26px 30px rgba(60, 26, 30, 0.28));
  }

  /* ---------- list ---------- */
  .board__list {
    padding: clamp(1rem, 2vw, 2rem) var(--gutter) clamp(3rem, 6vw, 6rem) clamp(1rem, 1.5vw, 1.75rem);
  }
  @media (min-width: 900px) {
    /* Closed, the four categories sit vertically centred next to the photo; once one is open the
       list starts at the top so growing content never shifts the headings. */
    .board__list {
      min-height: var(--panel-h);
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
    }
    .board__list:not(:has(details[open])) {
      justify-content: center;
    }
  }
  .board__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
    cursor: pointer;
    padding: 0.45em 0;
    border-top: 1px solid var(--ink);
    transition: color var(--dur);
  }
  .board__row::-webkit-details-marker {
    display: none;
  }
  .board__row--cat {
    padding-top: clamp(1.4rem, 3vw, 3.25rem);
    padding-bottom: 0.6em;
  }
  /* sub-sections (Hot · Iced · Salty · Sweet): plain uppercase label, no tint/icon/count */
  .board__row--sub {
    margin-top: 0.75em;
    padding: 0.55em 0.9em;
    border-top: 0;
    color: var(--ink);
  }
  .board__sub-name {
    display: flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--font-ui);
    font-weight: 600;
    font-style: normal;
    font-size: calc(var(--text-menu-title) * 0.62);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .board__row--sub .board__toggle {
    font-size: calc(var(--text-menu-title) * 0.85);
  }
  /* items inside a sub-section are indented under its band */
  .board__sub > .board__panel > .board__items {
    padding-left: 0.9em;
    padding-right: 0.9em;
  }
  .board__cat:first-of-type > .board__row--cat {
    border-top: 0;
  }
  .board__cat-name,
  .board__sub-name {
    font-family: var(--font-body);
    font-weight: 700;
    font-style: italic;
    font-size: var(--text-menu-title);
    text-transform: uppercase;
    line-height: 1.2;
  }
  .board__toggle {
    font-family: var(--font-body);
    font-weight: 700;
    font-style: italic;
    font-size: var(--text-menu-title);
    line-height: 1;
    width: 1em;
    text-align: right;
    flex: none;
  }
  .board__toggle::before {
    content: '+';
  }
  details[open] > summary .board__toggle::before {
    content: '−';
  }
  .board__row:hover .board__cat-name,
  .board__row:hover .board__sub-name {
    color: var(--bark);
  }
  .board__cat-desc {
    font-family: var(--font-ui);
    font-weight: 300;
    font-style: italic;
    font-size: var(--text-menu-desc);
    padding: 0.5em 0 0.8em;
  }
  .board__sub {
    margin-top: 0.6em;
  }
  .board__panel {
    overflow: hidden;
  }
  .board__items {
    padding: 0.4em 0 clamp(1.25rem, 3vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 0.45em;
  }
  .board__item {
    border-top: 1px solid rgba(60, 26, 30, 0.35);
    padding: 1em 0 0.85em;
    scroll-margin-top: 30vh;
  }
  .board__item:first-child {
    border-top: 0;
    padding-top: 0.6em;
  }
  /* items slide in as the section opens */
  details[open] > .board__panel .board__item {
    animation: board-item-in 420ms var(--ease-out) both;
  }
  details[open] > .board__panel .board__item:nth-child(2) { animation-delay: 40ms; }
  details[open] > .board__panel .board__item:nth-child(3) { animation-delay: 80ms; }
  details[open] > .board__panel .board__item:nth-child(4) { animation-delay: 120ms; }
  details[open] > .board__panel .board__item:nth-child(5) { animation-delay: 160ms; }
  details[open] > .board__panel .board__item:nth-child(n + 6) { animation-delay: 200ms; }
  @keyframes board-item-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .board__toggle::before {
    display: inline-block;
    transition: transform 320ms var(--ease-out);
  }
  details[open] > summary .board__toggle::before {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    details[open] > .board__panel .board__item {
      animation: none;
    }
  }
  .board__item-btn {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    text-align: left;
    font-family: var(--font-body);
    font-weight: 700;
    font-style: italic;
    font-size: var(--text-menu-title);
    line-height: 1.2;
    transition: color var(--dur);
  }
  .board__item-btn {
    transition: color var(--dur);
  }
  .board__item-btn:hover,
  .board__item-btn[aria-pressed='true'] {
    color: var(--bark);
  }
  .board__cat {
    animation: fade-up-in 700ms var(--ease-out) both;
  }
  .board__cat:nth-of-type(2) { animation-delay: 90ms; }
  .board__cat:nth-of-type(3) { animation-delay: 180ms; }
  .board__cat:nth-of-type(4) { animation-delay: 270ms; }
  .board__cat:nth-of-type(5) { animation-delay: 360ms; }
  .board__item-btn:hover .board__item-name,
  .board__item-btn[aria-pressed='true'] .board__item-name {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.14em;
  }
  .board__tag {
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.5em;
    padding: 0.18em 0.6em 0.2em;
    border-radius: var(--radius-pill);
    background: var(--bark);
    color: var(--cream-bright);
    /* Same small uppercase pill for every label (Signature, Popular, locations…). */
    font-family: var(--font-ui);
    font-weight: 700;
    font-style: normal;
    font-size: max(0.36em, 0.62rem); /* never below ~10px on phones */
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translateY(-0.15em);
  }
  /* Location badges: one colour per café so they read at a glance next to Signature / Popular. */
  .board__tag[data-tag='rea-farms'] {
    background: #5d6b3d; /* olive */
  }
  .board__tag[data-tag='south-end'] {
    background: #8a4b2f; /* terracotta */
  }
  .board__tag[data-tag='lake-norman'] {
    background: #3f6273; /* lake blue */
  }
  .board__price {
    font-family: var(--font-body);
    font-weight: 700;
    font-style: italic;
    font-size: 0.8em;
    white-space: nowrap;
    flex: none;
  }
  .board__desc {
    font-family: var(--font-ui);
    font-weight: 300;
    font-style: italic;
    font-size: var(--text-menu-desc);
    line-height: 1.45;
    margin-top: 0.5em;
    max-width: 38em;
  }
  .board__variants {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 1.5em;
    margin-top: 0.4em;
    font-family: var(--font-ui);
    font-weight: 300;
    font-style: italic;
    font-size: var(--text-small);
  }
  .board__variants .board__price {
    font-size: 1em;
  }
</style>
