---
/**
 * Wood header band with the hand-written logo, the three-dot menu toggle from
 * the PDF, the full-screen navigation overlay and the linen curtain that hangs
 * below the band on every page.
 */
import { getImage, Image } from 'astro:assets';
import type { SiteSettings } from '@/lib/cms/types';
import { isExternal } from '@/utils/format';
import Logo from '@/assets/brand/logo-wordmark.svg';
import MenuIcon from '@/assets/brand/menu-toggle.svg';
import Icon from '@/components/ui/Icon.astro';
import wood from '@/assets/textures/wood.jpg';
import logoWhite from '@/assets/brand/babaloo-logo-white.png';
import curtain from '@/assets/textures/curtain.png';
import { getContent } from '@/lib/cms';
import { imageOptions, resolveImage } from '@/lib/images';

interface Props {
  settings: SiteSettings;
  /** Renders the logo inside an <h1> (home page only). */
  isHome?: boolean;
  currentPath: string;
}

const { settings, isHome = false, currentPath } = Astro.props;
const { design } = await getContent();
const h = design.header;
// Settings > Design can replace the wood, the logos and the curtain; otherwise the originals are used.
const woodImg = h.wood
  ? await getImage({ ...imageOptions(h.wood, Math.min(928, h.wood.width)), format: 'webp', quality: 60 })
  : await getImage({ src: wood, width: 464, format: 'webp', quality: 60 });
const woodSize = h.wood ? `${Math.round(Math.min(928, h.wood.width) / 2)}px` : '464px';
const customLogo = h.logo ? await getImage({ ...imageOptions(h.logo, Math.min(800, h.logo.width)), format: h.logo.src.endsWith('.svg') ? 'svg' : 'webp', quality: 85 }) : undefined;
const menuLogo = h.menuLogo ? resolveImage(h.menuLogo) : logoWhite;
const curtainSrc = h.curtain ? resolveImage(h.curtain) : curtain;
const curtainSize = h.curtain ? { width: h.curtain.width, height: h.curtain.height } : {};
const menuLogoSize = h.menuLogo ? { width: h.menuLogo.width, height: h.menuLogo.height } : {};
const social = settings.social;
const logoAlt = `${settings.name} — home`;
---

<header class:list={['header', !h.sticky && 'header--static']} style={`--wood:url(${woodImg.src});--wood-size:${woodSize}`}>
  <div class="header__band">
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
      data-nav-toggle
    >
      <MenuIcon class="nav-toggle__icon" />
    </button>

    {
      isHome ? (
        <h1 class="header__brand">
          <a href="/" class="header__logo-link" aria-label={logoAlt}>
            {customLogo ? <img src={customLogo.src} alt="" width={customLogo.attributes.width} height={customLogo.attributes.height} class="header__logo" decoding="async" /> : <Logo class="header__logo" />}
          </a>
        </h1>
      ) : (
        <p class="header__brand">
          <a href="/" class="header__logo-link" aria-label={logoAlt}>
            {customLogo ? <img src={customLogo.src} alt="" width={customLogo.attributes.width} height={customLogo.attributes.height} class="header__logo" decoding="async" /> : <Logo class="header__logo" />}
          </a>
        </p>
      )
    }
  </div>

  <nav id="site-nav" class="site-nav" aria-label="Main" data-nav hidden>
    <div class="site-nav__inner container">
      <button class="site-nav__close" type="button" aria-label="Close menu" data-nav-close>
        <span aria-hidden="true">×</span>
      </button>
      <ul role="list" class="site-nav__list">
        {
          settings.nav.map((item, i) => {
            const external = item.external ?? isExternal(item.href);
            const base = item.href.split('#')[0] || '/';
            const current = !external && (base === '/' ? currentPath === '/' && !item.href.includes('#') : currentPath === base || currentPath.startsWith(`${base}/`));
            return (
              <li style={`--i:${i}`}>
                <a
                  href={item.href}
                  class="site-nav__link"
                  aria-current={current ? 'page' : undefined}
                  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
      <div class="site-nav__lockup">
        <Icon name="dog-poodle" class="site-nav__dog" />
        <Image src={menuLogo as never} {...(menuLogoSize as { width: number; height: number })} alt={`${settings.name} — ${settings.tagline ?? 'Coffee & Matcha Club'}`} widths={[320, 480, 720]} sizes="(min-width: 900px) 22rem, 44vw" format="webp" quality={82} class="site-nav__logo" loading="lazy" />
        <Icon name="dog-basenji" class="site-nav__dog site-nav__dog--right" />
      </div>
      <div class="site-nav__aside">
        <div class="site-nav__meta">
          {settings.email && <a href={`mailto:${settings.email}`}>{settings.email}</a>}
          {settings.phone && <a href={`tel:${settings.phone.replace(/[^+\d]/g, '')}`}>{settings.phone}</a>}
          {
            social.length > 0 && (
              <ul role="list" class="site-nav__social">
                {social.map((s) => (
                  <li>
                    <a href={s.url} target="_blank" rel="noopener">
                      {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
    </div>
  </nav>

  {h.showCurtain && <Image src={curtainSrc as never} {...(curtainSize as { width: number; height: number })} alt="" widths={[640, 1280, 1920]} sizes="100vw" format="webp" quality={72} loading="eager" class="curtain" />}
</header>

<script>
  import { initNav } from '@/scripts/nav';
  document.addEventListener('astro:page-load', initNav);
</script>

<style>
  .header {
    /* Sticky on every breakpoint; the curtain hangs below it over the content. */
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .header--static {
    position: relative;
  }
  .header__band {
    position: relative;
    z-index: 2; /* above the curtain, which starts underneath the wood */
    height: var(--header-h);
    background-color: var(--wood-bg, #58473a);
    background-image: var(--wood);
    background-size: var(--wood-size, 464px) auto;
    background-repeat: repeat;
    display: grid;
    place-items: center;
    color: var(--cream-bright);
    box-shadow: 0 6px 22px -10px rgba(0, 0, 0, 0.55);
  }
  .header__brand {
    margin: 0;
    font-size: 0;
    line-height: 0;
  }
  .header__logo-link {
    display: block;
    color: var(--cream-bright);
  }
  .header__logo {
    /* PDF: 500px wide on a 1920 artboard, scaled down ~30% */
    width: calc(clamp(5.75rem, 11.5vw, 12.5rem) * var(--logo-scale, 1));
    max-height: calc(var(--header-h) * 0.86);
    object-fit: contain;
    height: auto;
    transition: transform var(--dur) var(--ease-out);
    animation: fade-up-in 900ms var(--ease-out) both;
  }
  .header__logo-link:hover .header__logo {
    transform: scale(1.02) rotate(-0.6deg);
  }

  /* three stacked dots at the far left, as in the PDF */
  .nav-toggle {
    position: absolute;
    left: clamp(0.75rem, 6vw, 7rem);
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    color: var(--cream-bright);
    border-radius: 50%;
    transition: background-color var(--dur);
  }
  .nav-toggle:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  .nav-toggle__icon {
    width: clamp(1.5rem, 2vw, 2.125rem);
    height: auto;
    aspect-ratio: 1;
  }

  .curtain {
    position: absolute;
    left: 0;
    right: 0;
    /* Starts under the wood band so no hairline can show between them (sub-pixel rounding). */
    top: calc(100% - 0.5rem);
    width: 100%;
    height: calc(var(--curtain-h) + 0.5rem);
    object-fit: cover;
    object-position: center bottom; /* keeps the ruffled edge, crops the top */
    z-index: 1;
    pointer-events: none;
    filter: drop-shadow(0 8px 10px rgba(0, 0, 0, 0.28));
    transform-origin: top center;
    animation: sway 9s ease-in-out infinite;
  }

  /* ---------- overlay navigation ---------- */
  .site-nav {
    position: fixed;
    inset: 0;
    z-index: 50;
    /* Paint under the phone's status bar / home indicator too. */
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
    background-color: var(--wood-bg, #58473a);
    background-image: var(--wood);
    background-size: var(--wood-size, 464px) auto;
    color: var(--cream-bright);
    overflow-y: auto;
    animation: nav-in 320ms var(--ease-out);
  }
  .site-nav[hidden] {
    display: none;
  }
  @keyframes nav-in {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .site-nav__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.5rem, 4vh, 3rem);
    padding-block: clamp(4rem, 8vh, 6rem);
  }
  .site-nav__close {
    position: absolute;
    top: clamp(0.75rem, 3vw, 2rem);
    right: clamp(0.75rem, 4vw, 3rem);
    width: 3rem;
    height: 3rem;
    font-size: 2.25rem;
    line-height: 1;
    border-radius: 50%;
    color: var(--cream-bright);
  }
  .site-nav__list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 2.5vh, 1.75rem);
    text-align: center;
  }
  .site-nav__list > li {
    animation: fade-up-in 520ms var(--ease-out) both;
    animation-delay: calc(80ms + var(--i, 0) * 70ms);
  }
  .site-nav__lockup,
  .site-nav__aside {
    animation: fade-up-in 700ms var(--ease-out) both;
    animation-delay: 420ms;
  }
  .site-nav__link {
    font-family: var(--font-ui);
    font-style: italic;
    text-transform: uppercase;
    font-size: clamp(1.4rem, 3.5vw, 2.4rem);
    text-decoration: none;
    letter-spacing: 0.02em;
    padding: 0.1em 0.2em;
    border-bottom: 2px solid transparent;
    transition: border-color var(--dur), opacity var(--dur);
  }
  .site-nav__link:hover,
  .site-nav__link:focus-visible,
  .site-nav__link[aria-current='page'] {
    border-bottom-color: currentColor;
  }
  .site-nav__lockup {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2%;
    width: clamp(14rem, 34vw, 36rem);
    margin-inline: auto;
  }
  .site-nav__logo {
    width: 44%;
    height: auto;
    flex: none;
  }
  .site-nav__aside {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(1rem, 4vw, 3rem);
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--text-small);
  }
  .site-nav__dog {
    width: 26%;
    aspect-ratio: 197 / 305;
    height: auto;
    flex: none;
    opacity: 0.95;
  }
  .site-nav__dog--right {
    aspect-ratio: 188 / 287;
  }
  .site-nav__meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }
  .site-nav__social {
    display: flex;
    gap: 1rem;
  }
  :global(body.nav-open) {
    overflow: hidden;
  }
</style>
