---
/**
 * Concrete footer from the PDF: full lockup (dogs + logo + "coffee & matcha
 * club"), the footer navigation row and the Instagram mark, followed by a
 * small legal line.
 */
import type { SiteSettings } from '@/lib/cms/types';
import { isExternal } from '@/utils/format';
import Section from '@/components/ui/Section.astro';
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import logoFooter from '@/assets/brand/logo-footer.png';
import SocialIcon from '@/components/ui/SocialIcon.astro';

interface Props {
  settings: SiteSettings;
}
const { settings } = Astro.props;
const year = new Date().getFullYear();
const address = settings.address;
---

<Section as="footer" background="concrete" padded="y" class="footer" ariaLabelledby="footer-heading">
  {/* Optional block rendered on the same concrete as the footer (About page: Contact us). */}
  <slot name="before" />
  <h2 id="footer-heading" class="visually-hidden">{settings.name}</h2>
  <div class="container footer__inner">
    <a href="/" class="footer__lockup reveal reveal--zoom" aria-label={`${settings.name} — home`}>
      <Icon name="dog-poodle" class="footer__dog" />
      <Image src={logoFooter} alt={`${settings.name} — ${settings.tagline ?? 'Coffee & Matcha Club'}`} widths={[320, 480, 720, 944]} sizes="(min-width: 1200px) 24rem, (min-width: 640px) 20vw, 44vw" format="webp" quality={82} class="footer__logo" loading="lazy" />
      <Icon name="dog-basenji" class="footer__dog footer__dog--right" />
    </a>

    {
      settings.footerNav.length > 0 && (
        <nav aria-label="Footer">
          <ul role="list" class="footer__nav">
            {settings.footerNav.map((item) => {
              const external = item.external ?? isExternal(item.href);
              return (
                <li>
                  <a href={item.href} class="eyebrow-link" {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      )
    }

    {
      settings.social.length > 0 && (
        <ul role="list" class="footer__social">
          {settings.social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" aria-label={s.label} class="footer__social-link">
                <SocialIcon platform={s.platform} />
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="footer__legal">
      © {year} {settings.copyright ?? settings.name}
      {address?.street && (
        <Fragment>
          {' · '}
          <span>
            {address.street}
            {address.suite ? `, ${address.suite}` : ''}, {address.city}, {address.region}
          </span>
        </Fragment>
      )}
      {settings.email && (
        <Fragment>
          {' · '}
          <a href={`mailto:${settings.email}`}>{settings.email}</a>
        </Fragment>
      )}
    </p>
    <p class="footer__credit">
      Developed by{' '}
      <a href="https://vektra.digital/en" target="_blank" rel="noopener">
        Vektra
      </a>
    </p>
  </div>
</Section>

<style>
  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    text-align: center;
  }
  /* PDF lockup ≈ 722×305 on 1920: dog · logo · dog */
  .footer__lockup {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2%;
    width: clamp(15rem, 34vw, 38rem);
    color: var(--ink);
  }
  .footer__dog {
    width: 26%;
    aspect-ratio: 197 / 305;
    height: auto;
    flex: none;
    transition: transform var(--dur) var(--ease-out);
  }
  .footer__lockup:hover .footer__dog {
    animation: float-y 1.6s ease-in-out infinite;
  }
  .footer__lockup:hover .footer__dog--right {
    animation-delay: 0.4s;
  }
  .footer__dog--right {
    aspect-ratio: 188 / 287;
  }
  .footer__logo {
    width: 44%;
    height: auto;
    flex: none;
  }
  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: clamp(1.25rem, 5vw, 6rem);
    row-gap: 0.75rem;
  }
  .footer__social {
    display: flex;
    gap: 1.25rem;
  }
  .footer__social-link {
    display: grid;
    place-items: center;
    width: clamp(2.5rem, 3.5vw, 3.75rem);
    height: clamp(2.5rem, 3.5vw, 3.75rem);
    color: var(--ink);
    transition: transform var(--dur) var(--ease-out);
  }
  .footer__social-link:hover {
    transform: translateY(-2px) scale(1.06);
  }
  .footer__legal {
    font-size: var(--text-small);
    font-style: italic;
    opacity: 0.85;
    max-width: 60ch;
  }
  .footer__credit {
    margin-top: -0.75rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .footer__credit a {
    text-decoration: underline;
  }
</style>
