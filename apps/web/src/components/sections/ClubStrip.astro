---
/**
 * Bark band with the two dogs and "COFFEE & MATCHA CLUB" repeated
 * (PDF about page). CSS marquee, same technique as IconStrip.
 */
import Icon from '@/components/ui/Icon.astro';

interface Props {
  speed?: number;
}
const { speed = 45 } = Astro.props;
const repeats = [0, 1, 2, 3, 4, 5];
---

<div class="club" style={`--speed:${speed}s`} aria-hidden="true">
  <div class="club__track">
    {
      [0, 1].map(() => (
        <ul role="list" class="club__set">
          {repeats.map(() => (
            <li class="club__unit">
              <span class="club__dog club__dog--poodle"><Icon name="dog-poodle" class="club__svg" /></span>
              <span class="club__word"><Icon name="wordmark-club" class="club__svg" /></span>
              <span class="club__dog club__dog--basenji"><Icon name="dog-basenji" class="club__svg" /></span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .club {
    height: var(--strip-h);
    background: var(--bark);
    color: var(--cream-bright);
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .club__track {
    display: flex;
    width: max-content;
    animation: club-marquee var(--speed) linear infinite;
    will-change: transform;
  }
  .club__set {
    display: flex;
  }
  .club__unit {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1vw, 1rem);
    padding-inline: clamp(0.5rem, 1.2vw, 1.5rem);
  }
  /* Sizes live on plain spans (Safari/WebKit sizes <svg><use> inconsistently inside a
     max-content flex track); the SVG simply fills its box. */
  .club__dog,
  .club__word {
    display: block;
    flex: none;
  }
  .club__dog {
    height: calc(var(--strip-h) * 0.72);
    aspect-ratio: 197 / 305;
  }
  .club__dog--basenji {
    aspect-ratio: 188 / 287;
  }
  .club__word {
    height: calc(var(--strip-h) * 0.22);
    aspect-ratio: 183 / 36;
  }
  .club__svg,
  :global(.club__svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Phones: the fluid strip gets too short and the units crowd each other — give them air. */
  @media (max-width: 767px) {
    .club {
      height: 4.75rem;
    }
    .club__unit {
      gap: 0.9rem;
      padding-inline: 1.25rem;
    }
    .club__dog {
      height: 3.1rem;
    }
    .club__word {
      height: 1.15rem;
    }
  }
  @keyframes club-marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .club__track {
      animation: none;
    }
  }
</style>
