---
/**
 * Renders the ordered, toggleable sections configured in the CMS (home page, the "extra sections"
 * of the other pages and the new pages). Adding a block type = one entry here + one block in apps/cms.
 */
import type { HomeSection, SiteContent } from '@/lib/cms/types';
import { featuredItems } from '@/lib/cms';
import Hero from './Hero.astro';
import IconStrip from './IconStrip.astro';
import NavRow from './NavRow.astro';
import Intro from './Intro.astro';
import Locations from './Locations.astro';
import ClubStrip from './ClubStrip.astro';
import FeaturedMenu from './FeaturedMenu.astro';
import GalleryGrid from './GalleryGrid.astro';
import Testimonials from './Testimonials.astro';
import CtaBlock from './CtaBlock.astro';
import RichText from './RichText.astro';
import FramesGrid from './FramesGrid.astro';
import FormSection from './FormSection.astro';
import Spacer from './Spacer.astro';
import Section from '@/components/ui/Section.astro';

interface Props {
  sections: HomeSection[];
  content: SiteContent;
}
const { sections, content } = Astro.props;
const enabled = sections.filter((s) => s.enabled);
---

{
  enabled.map((section) => {
    switch (section.type) {
      case 'hero':
        return <Hero section={section} />;
      case 'iconStrip':
        return <IconStrip section={section} />;
      case 'navRow':
        return <NavRow links={content.settings.nav} />;
      case 'intro':
        return <Intro text={section.text} title={section.title} cta={section.cta} id={section.anchor} align={section.align} />;
      case 'locations':
        return <Locations locations={section.items.filter((l) => l.status !== 'closed')} id={section.anchor ?? 'locations'} title={section.title} text={section.text} />;
      case 'clubStrip':
        return <ClubStrip speed={section.speed} />;
      case 'featuredMenu':
        return (
          <FeaturedMenu items={featuredItems(content.menu.items, section.limit)} title={section.title} text={section.text} cta={section.cta} currency={content.menu.currency} id={section.anchor ?? 'featured'} />
        );
      case 'gallery':
        return section.images.length ? <GalleryGrid gallery={{ id: section.id, name: section.title ?? 'Gallery', slug: section.id, images: section.images }} title={section.title} limit={section.limit} cta={section.cta} id={section.anchor ?? 'gallery'} /> : null;
      case 'testimonials':
        return <Testimonials items={section.items} title={section.title} id={section.anchor ?? 'testimonials'} />;
      case 'cta':
        return <CtaBlock section={section} />;
      case 'richText':
        return <RichText section={section} />;
      case 'frames':
        return (
          <Section id={section.anchor ?? section.id} padded="y">
            <FramesGrid items={section.items} columns={section.columns} autoplay={section.autoplay} title={section.title} class="container" />
          </Section>
        );
      case 'form':
        return <FormSection section={section} content={content} />;
      case 'spacer':
        return <Spacer section={section} />;
      default:
        return null;
    }
  })
}
