---
/**
 * Three gold frames with the locations underneath (PDF page 1): address,
 * hours and a "map" link; "COMING SOON" for future locations. The section is
 * the scroll target of the "Locations" navigation link.
 */
import type { Location } from '@/lib/cms/types';
import Frame from '@/components/ui/Frame.astro';

interface Props {
  locations: Location[];
  id?: string;
  title?: string;
  text?: string;
}
const { locations, id = 'locations', title = 'Locations', text } = Astro.props;
// Desktop columns: up to 3 per row, but 4 locations read better as 2 + 2.
const cols = locations.length === 4 ? 2 : Math.min(3, Math.max(1, locations.length));
---

<section class="locations" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`} class="visually-hidden">{title}</h2>
    {text && <p class="locations__text">{text}</p>}
    <ul role="list" class="locations__grid reveal-stagger" style={`--cols:${cols}`}>
      {
        locations.map((loc, i) => (
          <li class="location reveal reveal--zoom" style={`--i:${i}`}>
            <Frame image={loc.image} label={loc.scriptName} loading="lazy" />
            <div class="location__body">
              <h3 class="visually-hidden">{loc.name}</h3>
              {loc.status === 'open' && loc.address?.street ? (
                <Fragment>
                  <address class="location__address">
                    {loc.address.street}
                    {loc.address.suite ? `, ${loc.address.suite}` : ''}
                    <br />
                    {loc.address.city}, {loc.address.region} {loc.address.postalCode ?? ''}
                  </address>
                  {loc.hoursDisplay.length > 0 && (
                    <div class="location__hours">
                      <p>Hours</p>
                      <dl>
                        {loc.hoursDisplay.map((h) => (
                          <div class="location__hours-row">
                            <dt>{h.days}</dt>
                            <dd>{h.hours}</dd>
                          </div>
                        ))}
                      </dl>
                    </div>
                  )}
                  <ul role="list" class="location__links">
                    {loc.mapUrl && (
                      <li>
                        <a href={loc.mapUrl} target="_blank" rel="noopener">
                          map
                        </a>
                      </li>
                    )}
                    {loc.orderUrl && (
                      <li>
                        <a href={loc.orderUrl} target="_blank" rel="noopener">
                          order
                        </a>
                      </li>
                    )}
                    {loc.phone && (
                      <li>
                        <a href={`tel:${loc.phone.replace(/[^+\d]/g, '')}`}>{loc.phone}</a>
                      </li>
                    )}
                  </ul>
                </Fragment>
              ) : (
                <p class="location__soon">{loc.note ?? (loc.status === 'coming-soon' ? 'Coming soon' : loc.name)}</p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .locations {
    background: var(--cream);
    /* PDF: frames start at 2870, footer at 3580 */
    padding-block: clamp(1.5rem, 4vw, 5rem) clamp(3rem, 6vw, 7rem);
    scroll-margin-top: 1rem;
  }
  .locations__text {
    text-align: center;
    font-style: italic;
    font-size: var(--text-body);
    margin-bottom: clamp(1.5rem, 3vw, 3rem);
  }
  /* Any number of locations: 1 per row on phones, 2 on tablets, --cols on desktop (never wider
     than a third of the page each); an incomplete last row is centred. */
  .locations__grid {
    --gap: clamp(1.5rem, 4vw, 5rem);
    --n: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    column-gap: var(--gap);
    row-gap: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 640px) {
    .locations__grid {
      --n: 2;
    }
  }
  @media (min-width: 1024px) {
    /* Each frame keeps the width of a third of the page; the row narrows to --cols frames. */
    .locations__grid {
      --n: var(--cols);
      max-width: calc(var(--cols) / 3 * (100% - 2 * var(--gap)) + (var(--cols) - 1) * var(--gap));
      margin-inline: auto;
    }
  }
  .location {
    flex: 0 0 calc((100% - (var(--n) - 1) * var(--gap)) / var(--n));
    min-width: 0;
    transition-delay: calc(var(--i) * 90ms);
  }
  @media (max-width: 639px) {
    .location {
      flex-basis: min(100%, 30rem);
    }
  }
  .location__body {
    /* PDF: 3350 → 3290 text starts ~90px under the frame */
    padding-top: clamp(1rem, 2vw, 2.25rem);
    padding-inline: clamp(0.5rem, 2vw, 2rem);
    font-style: italic;
    font-size: var(--text-small);
    line-height: 1.4;
    min-height: 8em;
  }
  .location__address {
    font-style: italic;
  }
  .location__hours {
    margin-top: 1.4em;
  }
  .location__hours dl {
    margin: 0;
  }
  .location__hours-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.4em;
  }
  .location__hours dd {
    margin: 0;
  }
  .location__links {
    display: flex;
    gap: 1.5em;
    margin-top: 1.6em;
  }
  .location__links a {
    display: inline-block;
    padding: 0.35em 0.1em;
    text-decoration: underline;
  }
  .location__soon {
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: center;
    padding-top: 2.5em;
  }
</style>
