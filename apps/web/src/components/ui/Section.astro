---
/**
 * Generic page band. Backgrounds map to the PDF surfaces: cream (page),
 * concrete texture (footer / contact / menu panel), sage (menu panel), bark
 * (icon strip). Textures are optimised through astro:assets.
 */
import { getImage } from 'astro:assets';
import concrete from '@/assets/textures/concrete.jpg';

interface Props {
  id?: string;
  as?: 'section' | 'div' | 'aside' | 'footer' | 'header';
  background?: 'cream' | 'concrete' | 'sage' | 'bark' | 'none';
  padded?: 'y' | 'y-sm' | 'none';
  class?: string;
  reveal?: boolean;
  ariaLabelledby?: string;
  /** Adds room for the curtain that hangs from the header (first band of a page). */
  offsetCurtain?: boolean;
}

const { id, as: Tag = 'section', background = 'cream', padded = 'y', class: className, reveal = false, ariaLabelledby, offsetCurtain = false } = Astro.props as Props;

const texture = background === 'concrete' ? await getImage({ src: concrete, width: 480, format: 'webp', quality: 55 }) : undefined;
---

<Tag
  id={id}
  class:list={['band', `band--${background}`, padded !== 'none' && `band--pad-${padded}`, offsetCurtain && 'band--curtain', reveal && 'reveal', className]}
  style={texture ? `--texture:url(${texture.src})` : undefined}
  aria-labelledby={ariaLabelledby}
>
  <slot />
</Tag>

<style>
  .band {
    position: relative;
    width: 100%;
  }
  .band--pad-y {
    padding-block: var(--section-y);
  }
  .band--pad-y-sm {
    padding-block: var(--section-y-sm);
  }
  .band--curtain {
    padding-top: calc(var(--curtain-h) + var(--section-y-sm));
  }
  .band--cream {
    background: var(--cream);
  }
  .band--sage {
    background: var(--sage);
  }
  .band--bark {
    background: var(--bark);
    color: var(--cream-bright);
  }
  .band--concrete {
    background-color: var(--concrete);
    background-image: var(--texture);
    background-size: 480px auto;
    background-repeat: repeat;
    background-position: center top;
  }
</style>
