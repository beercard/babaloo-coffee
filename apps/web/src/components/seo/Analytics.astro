---
/**
 * Marketing tags. Every tag is optional and driven by PUBLIC_* environment
 * variables; when a variable is empty nothing is rendered, so the production
 * build ships zero third-party JavaScript until the client opts in.
 *
 *   PUBLIC_GTM_ID          → Google Tag Manager (recommended: manage the rest from GTM)
 *   PUBLIC_GA4_ID          → Google Analytics 4 (gtag). Defaults to Babaloo's property on the live
 *                            site; the preview site (PAYLOAD_DRAFTS=1) and local dev send nothing.
 *                            Events are tracked by scripts/analytics.ts.
 *   PUBLIC_GADS_ID         → Google Ads conversion tag (gtag)
 *   PUBLIC_META_PIXEL_ID   → Meta Pixel
 */
const gtm = import.meta.env.PUBLIC_GTM_ID;
const isLive = import.meta.env.PROD && import.meta.env.PAYLOAD_DRAFTS !== '1';
const ga4 = import.meta.env.PUBLIC_GA4_ID || (isLive ? 'G-Q88BBY2LQ8' : undefined);
const gads = import.meta.env.PUBLIC_GADS_ID;
const pixel = import.meta.env.PUBLIC_META_PIXEL_ID;
const gtagIds = [ga4, gads].filter(Boolean) as string[];
---

{
  gtm && (
    <script is:inline define:vars={{ gtm }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s);
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtm);
    </script>
  )
}

{
  gtagIds.length > 0 && (
    <Fragment>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gtagIds[0]}`} />
      <script is:inline define:vars={{ gtagIds }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtagIds.forEach(function (id) {
          gtag('config', id);
        });
      </script>
      <script>
        import { initAnalytics } from '@/scripts/analytics';
        document.addEventListener('astro:page-load', initAnalytics);
      </script>
    </Fragment>
  )
}

{
  pixel && (
    <Fragment>
      <script is:inline define:vars={{ pixel }}>
        !(function (f, b, e, v, n, t, s) {
          if (f.fbq) return;
          n = f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n;
          n.push = n;
          n.loaded = !0;
          n.version = '2.0';
          n.queue = [];
          t = b.createElement(e);
          t.async = !0;
          t.src = v;
          s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixel);
        fbq('track', 'PageView');
      </script>
      <noscript>
        <img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${pixel}&ev=PageView&noscript=1`} />
      </noscript>
    </Fragment>
  )
}
