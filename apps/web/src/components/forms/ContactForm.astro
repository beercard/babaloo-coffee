---
/** CONTACT US (PDF): fields, labels and messages come from Settings > Forms. */
import type { FormConfig } from '@/lib/cms/types';
import { DEFAULT_FORMS } from '@/lib/cms/defaults';
import SiteForm from './SiteForm.astro';

interface Props {
  email?: string;
  config?: FormConfig;
  ariaLabelledby?: string;
}
const { email, config = DEFAULT_FORMS.contact, ariaLabelledby } = Astro.props;
---

<SiteForm form="contact" config={config} email={email} ariaLabelledby={ariaLabelledby} />
