---
/** CONTACT US: Name · Email (required) · Phone number · Comment · send. */
import FormShell from './FormShell.astro';
import FormField from './FormField.astro';

interface Props {
  email?: string;
  ariaLabelledby?: string;
}
const { email, ariaLabelledby } = Astro.props;
---

<FormShell form="contact" email={email} submitLabel="send" successMessage="Thank you! Your message is on its way." ariaLabelledby={ariaLabelledby} class="contact-form">
  <FormField name="name" label="Name" autocomplete="name" maxlength={120} />
  <FormField name="email" label="Email" type="email" required autocomplete="email" maxlength={200} />
  <FormField name="phone" label="Phone number" type="tel" autocomplete="tel" maxlength={30} />
  <FormField name="message" label="Comment" type="textarea" maxlength={3000} rows={3} />
</FormShell>
