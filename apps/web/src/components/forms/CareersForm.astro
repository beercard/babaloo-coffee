---
/** JOIN OUR TEAM (PDF about page): fields, dropdowns and messages come from Settings > Forms. */
import type { FormConfig } from '@/lib/cms/types';
import { DEFAULT_FORMS } from '@/lib/cms/defaults';
import SiteForm from './SiteForm.astro';

interface Props {
  email?: string;
  config?: FormConfig;
  ariaLabelledby?: string;
}
const { email, config = DEFAULT_FORMS.careers, ariaLabelledby } = Astro.props;
---

<SiteForm form="careers" config={config} email={email} ariaLabelledby={ariaLabelledby} />
