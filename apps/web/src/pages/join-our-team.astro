---
/** Careers — same URL as WordPress (/join-our-team/). */
import Base from '@/layouts/Base.astro';
import Picture from '@/components/ui/Picture.astro';
import CareersForm from '@/components/forms/CareersForm.astro';
import { getContent } from '@/lib/cms';
import { breadcrumbSchema } from '@/utils/schema';

const content = await getContent();
const { joinPage, settings } = content;
const siteUrl = Astro.site?.href ?? 'https://babaloocoffeeclub.com/';
const schema = [
  breadcrumbSchema([
    { name: 'Home', url: siteUrl },
    { name: 'Join our team', url: `${siteUrl}join-our-team` },
  ]),
];
---

<Base seo={joinPage.seo} title={joinPage.title} schema={schema} bodyClass="page-join">
  <section class="join" aria-labelledby="join-title">
    {
      joinPage.image && (
        <div class="join__photo">
          <Picture image={joinPage.image} sizes="(min-width: 900px) 50vw, 100vw" widths={[480, 768, 1024, 1400]} loading="eager" fetchpriority="high" class="join__img" />
        </div>
      )
    }
    <div class="join__form">
      <h1 id="join-title" class="join__title ui">{joinPage.title}</h1>
      {joinPage.text && <p class="join__text italic">{joinPage.text}</p>}
      <CareersForm email={settings.email} positions={joinPage.positions} experienceLevels={joinPage.experienceLevels} ariaLabelledby="join-title" />
    </div>
  </section>
</Base>

<style>
  .join {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--cream);
    padding-top: var(--curtain-h);
  }
  @media (min-width: 900px) {
    .join {
      grid-template-columns: 1fr 1fr;
    }
  }
  .join__photo {
    min-height: 18rem;
  }
  .join__photo :global(picture),
  .join__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    max-height: 60rem;
  }
  .join__form {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1rem, 2vw, 2rem);
    padding: clamp(2rem, 5vw, 6rem) var(--gutter);
  }
  .join__title {
    font-weight: 700;
    font-size: var(--text-title);
    text-transform: uppercase;
    text-align: center;
  }
  .join__text {
    text-align: center;
    font-size: var(--text-body-sm);
  }
</style>
