---
/** Contact — replaces /contact-us/ (301). Form on concrete + editable details column. */
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';
import ContactForm from '@/components/forms/ContactForm.astro';
import { getContent, sortedLocations } from '@/lib/cms';
import { breadcrumbSchema } from '@/utils/schema';

const content = await getContent();
const { contactPage, settings } = content;
const first = sortedLocations(content.locations).find((l) => l.status === 'open');
const d = contactPage.details;

// Editable details, falling back to Site settings / the first open location.
const email = d.email ?? settings.email;
const phone = d.phone ?? settings.phone ?? first?.phone;
const locationName = d.locationName ?? first?.name;
const addressLines = d.address
  ? d.address.split(/\r?\n/).map((l) => l.trim()).filter(Boolean)
  : first?.address?.street
    ? [`${first.address.street}${first.address.suite ? `, ${first.address.suite}` : ''}`, `${first.address.city}, ${first.address.region} ${first.address.postalCode ?? ''}`.trim()]
    : [];
const hours = d.hours.length ? d.hours : (first?.hoursDisplay ?? []);
const mapUrl = d.mapUrl ?? first?.mapUrl ?? settings.mapUrl;
const mapLabel = d.mapLabel ?? 'map';
const social = d.showSocial ? settings.social : [];

const siteUrl = Astro.site?.href ?? 'https://babaloocoffeeclub.com/';
const schema = [
  breadcrumbSchema([
    { name: 'Home', url: siteUrl },
    { name: 'Contact', url: `${siteUrl}contact` },
  ]),
];
---

<Base seo={contactPage.seo} title={contactPage.title} schema={schema} bodyClass="page-contact">
  <Section background="concrete" padded="y" offsetCurtain class="contact-page" ariaLabelledby="contact-title">
    <div class="container contact-page__inner">
      <div class="contact-page__form reveal reveal--left">
        <h1 id="contact-title" class="contact-page__title ui">{contactPage.title}</h1>
        {contactPage.text && <p class="contact-page__text italic">{contactPage.text}</p>}
        <ContactForm email={email} ariaLabelledby="contact-title" />
      </div>
      <aside class="contact-page__aside reveal reveal--right" aria-label="Contact details">
        {email && (
          <p>
            <a href={`mailto:${email}`}>{email}</a>
          </p>
        )}
        {phone && (
          <p>
            <a href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{phone}</a>
          </p>
        )}
        {
          (locationName || addressLines.length > 0 || hours.length > 0 || mapUrl) && (
            <div class="contact-page__location">
              {locationName && <h2 class="contact-page__loc-name">{locationName}</h2>}
              {addressLines.length > 0 && (
                <address>
                  {addressLines.map((line, i) => (
                    <Fragment>
                      {line}
                      {i < addressLines.length - 1 && <br />}
                    </Fragment>
                  ))}
                </address>
              )}
              {hours.length > 0 && (
                <dl class="contact-page__hours">
                  {hours.map((h) => (
                    <div>
                      <dt>{h.days}</dt>
                      <dd>{h.hours}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {mapUrl && (
                <a href={mapUrl} target="_blank" rel="noopener">
                  {mapLabel}
                </a>
              )}
            </div>
          )
        }
        {
          social.length > 0 && (
            <ul role="list" class="contact-page__social">
              {social.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener">
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </aside>
    </div>
  </Section>
</Base>

<style>
  .contact-page__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 5rem);
  }
  @media (min-width: 900px) {
    .contact-page__inner {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
  }
  .contact-page__form {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 2rem);
  }
  .contact-page__title {
    font-weight: 700;
    font-size: var(--text-title);
    text-transform: uppercase;
    text-align: center;
  }
  .contact-page__text {
    text-align: center;
    font-size: var(--text-body-sm);
  }
  .contact-page__aside {
    font-style: italic;
    font-size: var(--text-body-sm);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: clamp(0rem, 2vw, 4rem);
  }
  .contact-page__loc-name {
    font-family: var(--font-ui);
    font-weight: 700;
    font-style: normal;
    text-transform: uppercase;
    font-size: var(--text-small);
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }
  .contact-page__hours {
    margin: 0.6rem 0;
  }
  .contact-page__hours div {
    display: flex;
    gap: 0.4em;
  }
  .contact-page__hours dd {
    margin: 0;
  }
  .contact-page__social {
    display: flex;
    gap: 1rem;
  }
</style>
