---
/** Menu — PDF page 2. */
import Base from '@/layouts/Base.astro';
import MenuBoard from '@/components/menu/MenuBoard.astro';
import { getContent, buildMenuTree } from '@/lib/cms';
import { breadcrumbSchema, menuSchema } from '@/utils/schema';
import { paragraphs } from '@/utils/format';

const content = await getContent();
const { menuPage, menu } = content;
const siteUrl = Astro.site?.href ?? 'https://babaloocoffeeclub.com/';

const tree = buildMenuTree(menu.categories, menu.items);
const sections = tree.flatMap((top) => [
  ...(top.items.length ? [{ name: top.category.name, items: top.items }] : []),
  ...top.children.map((sub) => ({ name: `${top.category.name} — ${sub.category.name}`, items: sub.items })),
]);
const schema = [
  breadcrumbSchema([
    { name: 'Home', url: siteUrl },
    { name: 'Menu', url: `${siteUrl}menu` },
  ]),
  menuSchema(siteUrl, sections, menu.currency),
];
---

<Base seo={menuPage.seo} title="Menu" schema={schema} bodyClass="page-menu">
  <section class="menu-intro" aria-labelledby="menu-title">
    <div class="container container--narrow text-center reveal">
      <h1 id="menu-title" class="menu-intro__title script">{menuPage.intro.title}</h1>
      {
        menuPage.intro.text &&
          paragraphs(menuPage.intro.text).map((lines, pi) => (
            <p class:list={['menu-intro__text', pi === 0 && 'menu-intro__text--lead']}>
              {lines.map((line, i) => (
                <Fragment>
                  {line}
                  {i < lines.length - 1 && <br />}
                </Fragment>
              ))}
            </p>
          ))
      }
    </div>
  </section>
  <MenuBoard menu={menu} showPrices={menuPage.showPrices} />
</Base>

<style>
  .menu-intro {
    /* PDF: curtain ends ≈470, script starts ≈520 */
    padding-block: calc(var(--curtain-h) + clamp(1.5rem, 2.5vw, 3rem)) clamp(1.5rem, 4vw, 4.5rem);
    background: var(--cream);
  }
  .menu-intro__title {
    font-size: var(--text-script);
  }
  .menu-intro__text {
    font-style: italic;
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    max-width: 60ch;
    margin-inline: auto;
    margin-top: 1em;
    text-wrap: pretty;
  }
  .menu-intro__text--lead {
    font-family: var(--font-script);
    font-style: normal;
    font-size: var(--text-script-sm);
    line-height: 1.1;
    max-width: none;
    margin-top: 0.1em;
  }
</style>
