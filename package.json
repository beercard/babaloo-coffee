{
  "name": "babaloo-coffee-club",
  "private": true,
  "version": "1.0.0",
  "description": "Babaloo Coffee Club — Astro frontend + Payload CMS monorepo",
  "workspaces": [
    "apps/web",
    "apps/cms"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:cms": "npm run dev --workspace apps/cms",
    "build": "npm run build --workspace apps/web",
    "build:cms": "npm run build --workspace apps/cms",
    "preview": "npm run preview --workspace apps/web",
    "check": "npm run check --workspace apps/web && npm run typecheck --workspace apps/cms",
    "seed:cms": "npm run seed --workspace apps/cms"
  }
}
